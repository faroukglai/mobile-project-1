{
  "expo": {
    "name": "Avenra",
    "slug": "growthfusion-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "avenra",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.faroukglai.avenra",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42f7e4f4-19d5-4d5e-bc8e-17fd8f5afe06"
      }
    },
    "owner": "farouk_glai"
  }
}
